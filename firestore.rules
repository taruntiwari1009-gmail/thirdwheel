rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isChatParticipant(chatId) {
      return signedIn()
        && exists(/databases/$(database)/documents/chats/$(chatId))
        && get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid]);
    }
    function isBlockedBetween(firstUid, secondUid) {
      return exists(/databases/$(database)/documents/users/$(firstUid)/blockedUsers/$(secondUid))
        || exists(/databases/$(database)/documents/users/$(secondUid)/blockedUsers/$(firstUid));
    }
    function validStringList(value, maxItems) {
      return value is list && value.size() <= maxItems && value.toSet().size() == value.size();
    }
    function validPublicProfile(userId) {
      return request.resource.data.keys().hasOnly([
        'uid','username','displayName','displayNameLower','photoURL','discoverable','pronouns','bio','interests','hobbies',
        'languages','education','institution','graduationYear','city','connectionGoals',
        'website','instagram','linkedin'
      ])
      && request.resource.data.keys().hasAll(['uid','displayName','displayNameLower','photoURL'])
      && request.resource.data.uid == userId && request.resource.data.uid == request.auth.uid
      && (!('username' in request.resource.data) || (request.resource.data.username is string && (request.resource.data.username == '' || request.resource.data.username.matches('^[a-z0-9_.]{3,24}$'))))
      && (!('discoverable' in request.resource.data) || request.resource.data.discoverable is bool)
      && (!('username' in request.resource.data) || request.resource.data.username == '' || getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == userId)
      && (!('pronouns' in request.resource.data) || (request.resource.data.pronouns is string && request.resource.data.pronouns.size() <= 40))
      && request.resource.data.displayName is string && request.resource.data.displayName.size() > 0 && request.resource.data.displayName.size() <= 80
      && request.resource.data.displayNameLower == request.resource.data.displayName.lower()
      && request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 2048
      && (!('bio' in request.resource.data) || (request.resource.data.bio is string && request.resource.data.bio.size() <= 300))
      && (!('education' in request.resource.data) || (request.resource.data.education is string && request.resource.data.education.size() <= 100))
      && (!('institution' in request.resource.data) || (request.resource.data.institution is string && request.resource.data.institution.size() <= 120))
      && (!('graduationYear' in request.resource.data) || (request.resource.data.graduationYear is string && request.resource.data.graduationYear.size() <= 4))
      && (!('city' in request.resource.data) || (request.resource.data.city is string && request.resource.data.city.size() <= 80))
      && (!('website' in request.resource.data) || (request.resource.data.website is string && request.resource.data.website.size() <= 300))
      && (!('instagram' in request.resource.data) || (request.resource.data.instagram is string && request.resource.data.instagram.size() <= 300))
      && (!('linkedin' in request.resource.data) || (request.resource.data.linkedin is string && request.resource.data.linkedin.size() <= 300))
      && (!('interests' in request.resource.data) || validStringList(request.resource.data.interests,20))
      && (!('hobbies' in request.resource.data) || validStringList(request.resource.data.hobbies,20))
      && (!('languages' in request.resource.data) || validStringList(request.resource.data.languages,20))
      && (!('connectionGoals' in request.resource.data) || validStringList(request.resource.data.connectionGoals,20));
    }
    function validChatId(chatId, participants) {
      return participants is list && participants.size() == 2 && participants[0] is string && participants[1] is string
        && participants[0] != participants[1]
        && chatId == (participants[0] < participants[1] ? participants[0] + participants[1] : participants[1] + participants[0]);
    }
    function validMessageRateLimit() {
      let limitId = 'messages_' + request.auth.uid;
      let limitPath = /databases/$(database)/documents/abuseLimits/$(limitId);
      let limit = getAfter(limitPath).data;
      return limit.uid == request.auth.uid
        && limit.updatedAt == request.time
        && limit.count is int
        && limit.count >= 1
        && limit.count <= 8;
    }
    function validMessage(messageId, chatId) {
      return request.resource.data.keys().hasOnly(['id','text','senderId','date','img'])
        && request.resource.data.keys().hasAll(['id','text','senderId','date'])
        && request.resource.data.id == messageId
        && request.resource.data.id is string && request.resource.data.id.size() > 0 && request.resource.data.id.size() <= 128
        && request.resource.data.text is string && request.resource.data.text.size() <= 4000
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.date is timestamp
        && (!('img' in request.resource.data) || (
          request.resource.data.img is string
          && request.resource.data.img.matches('^chat-images/' + chatId + '/' + request.auth.uid + '/[A-Za-z0-9_.-]{1,180}$')
        ))
        && (request.resource.data.text.size() > 0 || ('img' in request.resource.data));
    }
