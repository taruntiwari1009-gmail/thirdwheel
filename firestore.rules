rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isChatParticipant(chatId) {
      return signedIn()
        && exists(/databases/$(database)/documents/chats/$(chatId))
        && get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid]);
    }
    function isBlockedBetween(firstUid, secondUid) {
      return exists(/databases/$(database)/documents/users/$(firstUid)/blockedUsers/$(secondUid))
        || exists(/databases/$(database)/documents/users/$(secondUid)/blockedUsers/$(firstUid));
    }
    function validStringList(value, maxItems) {
      return value is list && value.size() <= maxItems && value.toSet().size() == value.size();
    }
    function validPublicProfile(userId) {
      return request.resource.data.keys().hasOnly([
        'uid','username','displayName','displayNameLower','photoURL','discoverable','pronouns','bio','interests','hobbies',
        'languages','education','institution','graduationYear','city','connectionGoals',
        'website','instagram','linkedin'
      ])
      && request.resource.data.keys().hasAll(['uid','displayName','displayNameLower','photoURL'])
      && request.resource.data.uid == userId && request.resource.data.uid == request.auth.uid
      && (!('username' in request.resource.data) || (request.resource.data.username is string && (request.resource.data.username == '' || request.resource.data.username.matches('^[a-z0-9_.]{3,24}$'))))
      && (!('discoverable' in request.resource.data) || request.resource.data.discoverable is bool)
      && (!('username' in request.resource.data) || request.resource.data.username == '' || getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == userId)
      && (!('pronouns' in request.resource.data) || (request.resource.data.pronouns is string && request.resource.data.pronouns.size() <= 40))
      && request.resource.data.displayName is string && request.resource.data.displayName.size() > 0 && request.resource.data.displayName.size() <= 80
      && request.resource.data.displayNameLower == request.resource.data.displayName.lower()
      && request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 2048
      && (!('bio' in request.resource.data) || (request.resource.data.bio is string && request.resource.data.bio.size() <= 300))
      && (!('education' in request.resource.data) || (request.resource.data.education is string && request.resource.data.education.size() <= 100))
      && (!('institution' in request.resource.data) || (request.resource.data.institution is string && request.resource.data.institution.size() <= 120))
      && (!('graduationYear' in request.resource.data) || (request.resource.data.graduationYear is string && request.resource.data.graduationYear.size() <= 4))
      && (!('city' in request.resource.data) || (request.resource.data.city is string && request.resource.data.city.size() <= 80))
      && (!('website' in request.resource.data) || (request.resource.data.website is string && request.resource.data.website.size() <= 300))
      && (!('instagram' in request.resource.data) || (request.resource.data.instagram is string && request.resource.data.instagram.size() <= 300))
      && (!('linkedin' in request.resource.data) || (request.resource.data.linkedin is string && request.resource.data.linkedin.size() <= 300))
      && (!('interests' in request.resource.data) || validStringList(request.resource.data.interests,20))
      && (!('hobbies' in request.resource.data) || validStringList(request.resource.data.hobbies,20))
      && (!('languages' in request.resource.data) || validStringList(request.resource.data.languages,20))
      && (!('connectionGoals' in request.resource.data) || validStringList(request.resource.data.connectionGoals,20));
    }
    function validChatId(chatId, participants) {
      return participants is list && participants.size() == 2 && participants[0] is string && participants[1] is string
        && participants[0] != participants[1]
        && chatId == (participants[0] < participants[1] ? participants[0] + participants[1] : participants[1] + participants[0]);
    }
    function validMessageRateLimit() {
      let limitId = 'messages_' + request.auth.uid;
      let limitPath = /databases/$(database)/documents/abuseLimits/$(limitId);
      let limit = getAfter(limitPath).data;
      return limit.uid == request.auth.uid
        && limit.updatedAt == request.time
        && limit.count is int
        && limit.count >= 1
        && limit.count <= 8;
    }
    function validMessage(message) {
      return message is map && message.keys().hasOnly(['id','text','senderId','date','img'])
        && message.keys().hasAll(['id','text','senderId','date'])
        && message.id is string && message.id.size() > 0 && message.id.size() <= 128
        && message.text is string && message.text.size() <= 4000
        && message.senderId == request.auth.uid && message.date is timestamp
        && (!('img' in message) || (message.img is string && message.img.size() <= 2048))
        && (message.text.size() > 0 || ('img' in message));
    }
    function validChatListEntry(userId, chatId) {
      let chat = getAfter(/databases/$(database)/documents/chats/$(chatId)).data;
      return signedIn() && chat.participants is list && chat.participants.hasAny([userId]) && chat.participants.hasAny([request.auth.uid])
        && request.resource.data.keys().hasOnly(['userInfo','date','lastMessage','unreadCount','lastReadAt'])
        && request.resource.data.keys().hasAll(['userInfo','date'])
        && request.resource.data.userInfo is map
        && request.resource.data.userInfo.keys().hasOnly(['uid','displayName','photoURL'])
        && request.resource.data.userInfo.uid is string && request.resource.data.userInfo.uid != userId
        && chat.participants.hasAny([request.resource.data.userInfo.uid])
        && request.resource.data.userInfo.displayName is string && request.resource.data.userInfo.photoURL is string
        && get(/databases/$(database)/documents/publicProfiles/$(request.resource.data.userInfo.uid)).data.displayName == request.resource.data.userInfo.displayName
        && get(/databases/$(database)/documents/publicProfiles/$(request.resource.data.userInfo.uid)).data.photoURL == request.resource.data.userInfo.photoURL
        && request.resource.data.date is timestamp
        && (!('unreadCount' in request.resource.data) || (request.resource.data.unreadCount is int && request.resource.data.unreadCount >= 0))
        && (!('lastReadAt' in request.resource.data) || request.resource.data.lastReadAt is timestamp)
        && (!('lastMessage' in request.resource.data) || (request.resource.data.lastMessage is map
          && request.resource.data.lastMessage.keys().hasOnly(['text']) && request.resource.data.lastMessage.text is string
          && request.resource.data.lastMessage.text.size() <= 4000));
    }
    match /usernames/{username} {
      allow read: if signedIn();
      allow create: if signedIn() && username.matches('^[a-z0-9_.]{3,24}$')
        && request.resource.data.keys().hasOnly(['uid','createdAt']) && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt is timestamp && !exists(/databases/$(database)/documents/usernames/$(username));
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data.username != username;
    }
    match /publicProfiles/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && validPublicProfile(userId);
      allow update: if signedIn() && request.auth.uid == userId && validPublicProfile(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'username','displayName','displayNameLower','photoURL','discoverable','pronouns','bio','interests','hobbies',
          'languages','education','institution','graduationYear','city','connectionGoals','website','instagram','linkedin'
        ]);
      allow delete: if signedIn() && request.auth.uid == userId;
    }
    match /users/{userId}/blockedUsers/{blockedUid} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId && blockedUid != userId
        && request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.createdAt is timestamp
        && exists(/databases/$(database)/documents/publicProfiles/$(blockedUid));
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid == userId;
    }
    match /reports/{reportId} {
      allow read, write: if false;
    }
    match /abuseLimits/{limitId} {
      allow read: if signedIn() && limitId == 'messages_' + request.auth.uid;
      allow create: if signedIn() && limitId == 'messages_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','count','windowStart','updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.count == 1
        && request.resource.data.windowStart == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn() && limitId == 'messages_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','count','windowStart','updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.count is int
        && ((request.resource.data.windowStart == resource.data.windowStart
          && request.resource.data.count == resource.data.count + 1
          && request.time < resource.data.windowStart + duration.value(60, 's')
          && request.resource.data.count <= 8)
          || (request.time >= resource.data.windowStart + duration.value(60, 's')
            && request.resource.data.count == 1
            && request.resource.data.windowStart == request.time));
      allow delete: if false;
    }
    match /accountDeletionRequests/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }
    // Moderation and account lifecycle records are trusted-server-only.
    match /moderationCases/{caseId} {
      allow read, write: if false;
    }
    match /moderationAudit/{eventId} {
      allow read, write: if false;
    }
    match /users/{userId}/userChats/{chatId} {
      allow read: if signedIn() && (request.auth.uid == userId || isChatParticipant(chatId));
      allow create: if validChatListEntry(userId,chatId);
      allow update: if validChatListEntry(userId,chatId) && isChatParticipant(chatId)
        && (request.auth.uid == userId
          ? request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage','date','unreadCount','lastReadAt'])
          : request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage','date','unreadCount']));
      allow delete: if signedIn() && request.auth.uid == userId && isChatParticipant(chatId);
    }
    match /chats/{chatId} {
      allow read: if signedIn() && resource.data.participants.hasAny([request.auth.uid]);
      allow create: if signedIn() && validChatId(chatId,request.resource.data.participants)
        && request.resource.data.participants.hasAny([request.auth.uid])
        && !isBlockedBetween(request.resource.data.participants[0],request.resource.data.participants[1])
        && request.resource.data.keys().hasOnly(['participants','messages'])
        && request.resource.data.messages is list && request.resource.data.messages.size() == 0;
      allow update: if signedIn() && resource.data.participants.hasAny([request.auth.uid])
        && !isBlockedBetween(resource.data.participants[0],resource.data.participants[1])
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['messages'])
        && request.resource.data.messages is list && request.resource.data.messages.size() == resource.data.messages.size()+1
        && request.resource.data.messages.hasAll(resource.data.messages)
        && validMessage(request.resource.data.messages[request.resource.data.messages.size()-1])
        && validMessageRateLimit();
      allow delete: if false;
    }
  }
}
