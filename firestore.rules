rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isChatParticipant(chatId) {
      return signedIn()
        && exists(/databases/$(database)/documents/chats/$(chatId))
        && get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid]);
    }

    function validPublicProfile(userId) {
      return request.resource.data.keys().hasOnly(['uid', 'displayName', 'photoURL'])
        && request.resource.data.keys().hasAll(['uid', 'displayName', 'photoURL'])
        && request.resource.data.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.photoURL is string
        && request.resource.data.photoURL.size() <= 2048;
    }

    function validChatId(chatId, participants) {
      return participants is list
        && participants.size() == 2
        && participants[0] is string
        && participants[1] is string
        && participants[0] != participants[1]
        && chatId == (participants[0] < participants[1]
          ? participants[0] + participants[1]
          : participants[1] + participants[0]);
    }

    function validMessage(message) {
      return message is map
        && message.keys().hasOnly(['id', 'text', 'senderId', 'date', 'img'])
        && message.keys().hasAll(['id', 'text', 'senderId', 'date'])
        && message.id is string
        && message.id.size() > 0
        && message.id.size() <= 128
        && message.text is string
        && message.text.size() <= 4000
        && message.senderId == request.auth.uid
        && message.date is timestamp
        && (!('img' in message) || (message.img is string && message.img.size() <= 2048))
        && (message.text.size() > 0 || ('img' in message));
    }

    function validChatListEntry(userId, chatId) {
      let chat = get(/databases/$(database)/documents/chats/$(chatId)).data;
      return signedIn()
        && chat.participants is list
        && chat.participants.hasAny([userId])
        && chat.participants.hasAny([request.auth.uid])
        && request.resource.data.keys().hasOnly(['userInfo', 'date', 'lastMessage'])
        && request.resource.data.keys().hasAll(['userInfo', 'date'])
        && request.resource.data.userInfo is map
        && request.resource.data.userInfo.keys().hasOnly(['uid', 'displayName', 'photoURL'])
        && request.resource.data.userInfo.uid is string
        && request.resource.data.userInfo.uid != userId
        && chat.participants.hasAny([request.resource.data.userInfo.uid])
        && request.resource.data.userInfo.displayName is string
        && request.resource.data.userInfo.photoURL is string
        && request.resource.data.date is timestamp
        && (!('lastMessage' in request.resource.data)
          || (request.resource.data.lastMessage is map
            && request.resource.data.lastMessage.keys().hasOnly(['text'])
            && request.resource.data.lastMessage.text is string
            && request.resource.data.lastMessage.text.size() <= 4000));
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && validPublicProfile(userId);
      allow update: if signedIn()
        && request.auth.uid == userId
        && validPublicProfile(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL']);
      allow delete: if signedIn() && request.auth.uid == userId;
      
      match /userChats/{chatId} {
        allow read: if signedIn() && (request.auth.uid == userId || isChatParticipant(chatId));
        allow create: if validChatListEntry(userId, chatId);
        allow update: if validChatListEntry(userId, chatId)
          && isChatParticipant(chatId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'date', 'userInfo']);
        allow delete: if signedIn()
          && request.auth.uid == userId
          && isChatParticipant(chatId);
      }
    }

    match /chats/{chatId} {
      allow read: if signedIn() && resource.data.participants.hasAny([request.auth.uid]);
      allow create: if signedIn()
        && validChatId(chatId, request.resource.data.participants)
        && request.resource.data.participants.hasAny([request.auth.uid])
        && request.resource.data.keys().hasOnly(['participants', 'messages'])
        && request.resource.data.messages is list
        && request.resource.data.messages.size() == 0;
      allow update: if signedIn()
        && resource.data.participants.hasAny([request.auth.uid])
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['messages'])
        && request.resource.data.messages is list
        && request.resource.data.messages.size() == resource.data.messages.size() + 1
        && request.resource.data.messages.toSet().hasAll(resource.data.messages.toSet())
        && validMessage(request.resource.data.messages[request.resource.data.messages.size() - 1]);
      allow delete: if false;
    }
  }
}